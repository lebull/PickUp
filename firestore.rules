rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isCoordinator() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.coordinator == true
      );
    }

    match /projects/{projectId} {
      allow read, write: if isCoordinator();
    }

    match /users/{uid} {
      allow read: if request.auth != null && (isSelf(uid) || isCoordinator());
      allow create: if isCoordinator() || (
        isSelf(uid) &&
        !(request.resource.data.roles is map)
      );
      allow update: if isCoordinator() || (
        isSelf(uid) &&
        request.resource.data.roles == resource.data.roles
      );
      allow delete: if false;
    }
  }
}
