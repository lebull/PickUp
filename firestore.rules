rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isCoordinator() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', {}).get('coordinator', false) == true
      );
    }

    match /projects/{projectId} {
      allow read, write: if isCoordinator();
    }

    match /users/{uid} {
      allow read: if request.auth != null && (isSelf(uid) || isCoordinator());
      // Users may create/update their own profile but never touch `roles`.
      allow create: if isCoordinator() || (
        isSelf(uid) &&
        !('roles' in request.resource.data)
      );
      allow update: if isCoordinator() || (
        isSelf(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles'])
      );
      allow delete: if false;
    }
  }
}
